classDiagram
    class Application {
        #45;name: String
        #45;version: String
        #43;initialize()
        #43;render()
        #43;handleErrors()
    }
    
    class Page {
        #45;id: String
        #45;title: String
        #45;url: String
        #45;webParts: Array
        #43;render()
        #43;load()
        #43;unload()
    }
    
    class HomePage {
        #45;id: "home"
