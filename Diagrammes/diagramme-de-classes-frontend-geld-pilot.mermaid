    class WebPart {
        #45;id: String
        #45;title: String
        #45;description: String
        #45;interfaces: Array
        #43;initialize()
        #43;render()
        #43;getPropertyPaneConfiguration()
    }
    
    class WelcomeWebPart {
        #45;message: String
        #43;navigateToLogin()
    }
    
    class InfoWebPart {
        #45;generalInfo: Array
        #43;displayInfo()
    }
    
    class FooterWebPart {
        #45;contactInfo: Object
        #45;quickLinks: Array
        #43;navigateToPage(pageId)
    }
    
    class LoginWebPart {
        #45;formFields: Array
        #43;validateRecaptcha()
        #43;authenticate()
        #43;navigateToRegister()
        #43;navigateToDashboard(userRole)
    }
    
    class RegisterWebPart {
        #45;formFields: Array
        #43;validateForm()
        #43;register()
        #43;navigateToLogin()
        #43;navigateToAccessInfo()
    }
    
    class AccessInfoWebPart {
        #45;documentation: String
        #43;sendRequestViaOutlook()
        #43;navigateToHome()
    }
    
    class AuthorizationWebPart {
        #45;authorizations: Array
        #43;createAuthorization()
        #43;viewAuthorizations()
        #43;updateAuthorizationStatus(id, status)
    }
    
    class ClientsChargesWebPart {
        #45;clients: Array
        #45;charges: Array
        #43;addClient()
        #43;addCharge()
        #43;filterData(criteria)
        #43;voiceCommandFilter()
    }
    
    class IASupportWebPart {
        #45;interfaces: Array
        #43;switchInterface(interfaceId)
    }
    
    class TechnicalSupportInterface {
        #45;chatHistory: Array
        #43;sendMessage()
        #43;generatePdfReport()
    }
    
    class GeldbotInterface {
        #45;chatHistory: Array
        #43;sendMessage()
        #43;queryData()
    }
    
    class PredictionWebPart {
        #45;predictions: Array
