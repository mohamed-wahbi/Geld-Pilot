    }
    
    class HistoryWebPart {
        #45;interfaces: Array
        #43;switchInterface(interfaceId)
    }
    
    class ChargeHistoryInterface {
        #45;yearlyCharges: Array
        #45;monthlyCharges: Array
        #43;viewChargesByYear(year)
        #43;viewChargesByMonth(year, month)
    }
    
    class InvoiceHistoryInterface {
        #45;clientInvoices: Array
        #43;viewInvoicesByClient(clientId)
        #43;viewInvoicesByPeriod(startDate, endDate)
    }
    
    class MonthlyActivityWebPart {
        #45;interfaces: Array
        #43;switchInterface(interfaceId)
    }
    
    class GenerateMonthlyResultInterface {
        #45;monthlyResults: Object
        #43;generateResults(year, month)
        #43;exportResults()
    }
    
    class RetrieveMonthlyDataInterface {
        #45;monthlyData: Object
        #43;retrieveData(year, month)
